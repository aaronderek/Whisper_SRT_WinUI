<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WhisperSubtitler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WhisperSubtitler.ViewModels"
    xmlns:conv="using:WhisperSubtitler.Converters"
    mc:Ignorable="d"
    Title="Whisper">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:BoolToBrushConverter x:Key="BoolToBrush" />

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== 标题栏 ===================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Asset/AppIcon.png" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock x:Uid="AppTitle" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>

        </Grid>

        <!-- ===================== 主体内容 ===================== -->
        <Grid Grid.Row="1" Margin="24,8,24,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 左：拖拽区 + 任务队列 -->
            <Grid Grid.Column="0" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="DropZone" Grid.Row="0" AllowDrop="True"
                        DragOver="OnDropZoneDragOver" Drop="OnDropZoneDrop"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24,20" MinHeight="152">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <Image Source="ms-appx:///Asset/AppIcon.png" Width="48" Height="48" HorizontalAlignment="Center" />
                        <TextBlock x:Uid="DropTitle" HorizontalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="DropSubtitle" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <Button x:Uid="BrowseFilesButton" Click="OnBrowseFilesClick" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="QueueTitle" Grid.Column="0" VerticalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button x:Uid="ClearButton" Grid.Column="1" Command="{Binding ClearCommand}"
                                    IsEnabled="{Binding CanEditList, Mode=OneWay}" />
                        </Grid>

                        <ListView Grid.Row="1" x:Name="JobsList"
                                  ItemsSource="{Binding Jobs, Mode=OneWay}"
                                  Padding="0,0,12,0"
                                  SelectionMode="None"
                                  Visibility="{Binding HasJobs, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:JobItem">
                                    <Grid Padding="12,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{Binding Status, Mode=OneWay, Converter={StaticResource StatusToBrush}}" />

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" />
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{Binding ErrorText, Mode=OneWay}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Visibility="{Binding ErrorText, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <HyperlinkButton x:Uid="OpenOutputButton" Click="OnOpenJobOutputClick"
                                                             Visibility="{Binding OutputPath, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                                            <Button x:Uid="RemoveJobButton" Click="OnRemoveJobClick" Background="Transparent" BorderThickness="0"
                                                    Padding="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                                    Visibility="{Binding HasJobs, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock x:Uid="QueueEmptyTitle" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="QueueEmptySubtitle" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右：设置面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <!-- 右侧留 14px 给覆盖式滚动条，避免与卡片重叠 -->
                <StackPanel Spacing="12" Margin="0,0,14,0">

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="ModelSectionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Models}" DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}" />
                            <TextBlock Text="{Binding ModelNote, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="TaskLanguageTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Languages}" DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                            <ToggleSwitch x:Uid="TranslateToggle"
                                          IsOn="{Binding Translate, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="OutputLocationTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <RadioButtons SelectedIndex="{Binding OutputModeIndex, Mode=TwoWay}">
                                <RadioButton x:Uid="OutputSameFolder" />
                                <RadioButton x:Uid="OutputCustomFolder" />
                            </RadioButtons>
                            <Grid ColumnSpacing="8"
                                  Visibility="{Binding CustomOutputEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="OutputFolderTextBox" Grid.Column="0" IsReadOnly="True"
                                         Text="{Binding CustomOutputFolder, Mode=OneWay}" />
                                <Button x:Uid="BrowseOutputButton" Grid.Column="1" Click="OnBrowseOutputFolderClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Expander x:Uid="AdvancedSettingsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Margin="0,4,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="ComputeTypeTitle" Style="{StaticResource CaptionTextBlockStyle}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding ComputeTypes}"
                                          SelectedItem="{Binding ComputeType, Mode=TwoWay}" />
                                <TextBlock x:Uid="ComputeTypeHint" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <NumberBox x:Uid="BeamSizeBox"
                                       Value="{Binding BeamSize, Mode=TwoWay}"
                                       Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" />
                            <NumberBox x:Uid="MaxLineCharsBox"
                                       Value="{Binding MaxLineChars, Mode=TwoWay}"
                                       Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                            <ToggleSwitch x:Uid="VadToggle"
                                          IsOn="{Binding UseVad, Mode=TwoWay}" />
                            <ToggleSwitch x:Uid="WordTimestampsToggle"
                                          IsOn="{Binding WordTimestamps, Mode=TwoWay}" />
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Uid="TranscriptOnlyToggle"
                                              IsOn="{Binding TranscriptOnly, Mode=TwoWay}" />
                                <TextBlock x:Uid="TranscriptOnlyHint" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="RuntimeSectionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding BackendStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding GpuStatusText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{Binding GpuStatusText, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button x:Uid="RecheckButton" Command="{Binding RecheckBackendCommand}"
                                        IsEnabled="{Binding CanEditList, Mode=OneWay}" />
                                <Button x:Uid="OpenSetupButton" Click="OnOpenSetupClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Expander x:Uid="LogExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="160"
                                 FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===================== 底部操作栏 ===================== -->
        <Border Grid.Row="2" Padding="24,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="{Binding CurrentStatus, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Maximum="100" Height="6" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Uid="SettingsButton" Height="40" Padding="12,0" Click="OnOpenSettingsClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                            <TextBlock x:Uid="SettingsButtonText" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Height="40" Padding="18,0"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding CanStart, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Uid="StartButtonText" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="CancelButton" Height="40" Padding="16,0"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding CanCancel, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 设置对话框 ===================== -->
        <ContentDialog x:Name="SettingsDialog" x:Uid="SettingsDialog" DefaultButton="Close">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel Spacing="20" MinWidth="480" Margin="0,0,14,0">

                    <!-- 应用语言 -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="AppLanguageTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="AppLanguageComboBox" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnAppLanguageSelectionChanged">
                            <ComboBoxItem x:Uid="LanguageSystem" Tag="system" />
                            <ComboBoxItem x:Uid="LanguageChinese" Tag="zh-CN" />
                            <ComboBoxItem x:Uid="LanguageEnglish" Tag="en-US" />
                        </ComboBox>
                        <TextBlock x:Uid="AppLanguageHint" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- 运行环境 / 一键安装 -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsRuntimeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding BackendStatusText, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="InstallDependenciesButton" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding InstallDependenciesCommand}"
                                    IsEnabled="{Binding CanInstallDependencies, Mode=OneWay}" />
                            <Button x:Uid="CancelEnvButton" Command="{Binding CancelEnvOpCommand}"
                                    Visibility="{Binding IsEnvBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <ProgressRing IsActive="{Binding IsEnvBusy, Mode=OneWay}" Width="20" Height="20"
                                          VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding EnvStatusText, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Visibility="{Binding EnvStatusText, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                        <TextBlock x:Uid="InstallDependenciesHint" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- 计算设备 -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="ComputeDeviceTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch x:Uid="ComputeDeviceToggle" IsOn="{Binding UseGpu, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 模型管理 -->
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="ModelManagementTitle" Grid.Column="0" VerticalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button x:Uid="RefreshModelsButton" Grid.Column="1" Command="{Binding RefreshModelsCommand}" />
                            <Button x:Uid="OpenCacheButton" Grid.Column="2" Command="{Binding OpenModelCacheCommand}" />
                        </Grid>
                        <TextBlock x:Uid="ModelManagementHint" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Uid="BackendRequiredHint" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding BackendReady, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding ModelItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelStatusItem">
                                    <Grid Padding="0,8" ColumnSpacing="12"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding StatusText, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>
                                        <ProgressRing Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center"
                                                      IsActive="{Binding Busy, Mode=OneWay}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button x:Uid="DownloadModelButton" Command="{Binding DownloadCommand}"
                                                    Visibility="{Binding Downloaded, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <Button x:Uid="DeleteModelButton" Command="{Binding DeleteCommand}"
                                                    Visibility="{Binding Downloaded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
